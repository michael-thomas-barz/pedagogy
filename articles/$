<script>
(() => {
  const openButton = document.getElementById("hp-feedback-open");
  const closeButton = document.getElementById("hp-feedback-close");
  const dialog = document.getElementById("hp-feedback-dialog");

  const form = document.getElementById("hp-feedback-form");
  const messageInput = document.getElementById("hp-feedback-message");

  const status = document.getElementById("hp-feedback-status");
  const submitButton = document.getElementById("hp-feedback-submit");

  const originalSubmitText = submitButton.textContent;

  function getPageTitle() {
    const h1 = document.querySelector("h1");

    if (h1 && h1.textContent.trim()) {
      return h1.textContent.trim();
    }

    return document.title || "Untitled page";
  }

  function resetStatus() {
    status.textContent = "";
    status.removeAttribute("data-state");

    submitButton.disabled = false;
    submitButton.textContent = originalSubmitText;
  }

  // Open feedback dialog
  openButton.addEventListener("click", () => {
    resetStatus();
    dialog.showModal();

    requestAnimationFrame(() => {
      messageInput.focus();
    });
  });

  // Close button
  closeButton.addEventListener("click", () => {
    dialog.close();
  });

  // Close when clicking the backdrop
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;

    const rect = dialog.getBoundingClientRect();

    const clickedInside =
      event.clientX >= rect.left &&
      event.clientX <= rect.right &&
      event.clientY >= rect.top &&
      event.clientY <= rect.bottom;

    if (!clickedInside) {
      dialog.close();
    }
  });

  // Submit feedback
  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) {
      return;
    }

    resetStatus();

    submitButton.disabled = true;
    submitButton.textContent = "Sending…";

    const data = new FormData(form);

    const payload = {
      message: data.get("message"),
      email: data.get("email"),
      pageTitle: getPageTitle(),
      pageUrl: window.location.href
    };

    try {
      const response = await fetch("/api/feedback", {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify(payload)
      });

      let result = {};

      try {
        result = await response.json();
      } catch (_) {
        // Ignore malformed/non-JSON response bodies.
      }

      if (!response.ok) {
        throw new Error(
          result.error || "Could not send feedback."
        );
      }

      status.textContent = "Thanks — your feedback was sent!";
      status.dataset.state = "success";

      submitButton.textContent = "Sent ✓";
      submitButton.disabled = true;

      // Clear the feedback but preserve the user's email address.
      messageInput.value = "";

      // Optional: automatically close after a short delay.
      // Uncomment if you prefer this behavior:
      //
      // setTimeout(() => {
      //   dialog.close();
      // }, 1200);

    } catch (error) {
      console.error("Feedback submission failed:", error);

      status.textContent =
        "Something went wrong. Please try again.";

      status.dataset.state = "error";

      submitButton.textContent = originalSubmitText;
      submitButton.disabled = false;
    }
  });
})();
</script>
