<script>
(function() {
  const CW = 44, CH = 32, GAP = 4;
  const VW = 680;

  const rows = [
    [1],
    [1,1],
    [1,2,1],
    [1,3,3,1],
    [1,4,6,4,1],
    [1,5,10,10,5,1],
    [1,6,15,20,15,6,1],
    [1,7,21,35,35,21,7,1]
  ];
  const ROW8 = [1,8,28,56,70,56,28,8,1];
  const N8 = ROW8.length;

  const ROW_H = CH + 8;

  function cellX(numInRow, i) {
    const total = numInRow * CW + (numInRow - 1) * GAP;
    return (VW - total) / 2 + i * (CW + GAP);
  }

  function cellCX(numInRow, i) {
    return cellX(numInRow, i) + CW / 2;
  }

  function makeCell(x, y, val, state) {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    const r = document.createElementNS('http://www.w3.org/2000/svg','rect');
    r.setAttribute('x', x); r.setAttribute('y', y);
    r.setAttribute('width', CW); r.setAttribute('height', CH);
    r.setAttribute('rx', 6); r.setAttribute('stroke-width', '0.75');

    let fill, stroke, textFill;
    if (state === 'highlight') {
      fill = '#FAEEDA'; stroke = '#854F0B'; textFill = '#633806';
    } else if (state === 'sum') {
      fill = '#E1F5EE'; stroke = '#0F6E56'; textFill = '#085041';
    } else if (state === 'edge') {
      fill = '#665c54'; stroke = 'var(--color-border-secondary)'; textFill = '#ebdbb2';
    } else if (state === 'blank') {
      fill = '#665c54'; stroke = 'var(--color-border-secondary)'; textFill = '#ebdbb2';
    } else {
      fill = '#665c54'; stroke = 'var(--color-border-secondary)'; textFill = '#ebdbb2';
    }

    r.setAttribute('fill', fill);
    r.setAttribute('stroke', stroke);
    g.appendChild(r);

    const t = document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x', x + CW/2); t.setAttribute('y', y + CH/2);
    t.setAttribute('text-anchor','middle'); t.setAttribute('dominant-baseline','central');
    t.setAttribute('font-size','13'); t.setAttribute('fill', textFill);
    t.setAttribute('font-family','var(--font-mono)');
    t.textContent = val;
    g.appendChild(t);
    return g;
  }

  function addArrow(svg, x1, y1, x2, y2) {
    const line = document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1', x1); line.setAttribute('y1', y1);
    line.setAttribute('x2', x2); line.setAttribute('y2', y2);
    line.setAttribute('stroke', '#854F0B');
    line.setAttribute('stroke-width', '1.5');
    line.setAttribute('stroke-linecap','round');
    svg.appendChild(line);
  }

  function render(stepIdx) {
    const svg = document.getElementById('pt-svg');
    svg.innerHTML = '';

    const totalSteps = 2 + (N8 - 2);
    const highlight = stepIdx >= 2 ? stepIdx - 2 + 1 : -1;

    for (let r = 0; r < rows.length; r++) {
      const row = rows[r];
      const y = r * ROW_H + 10;
      for (let i = 0; i < row.length; i++) {
        const x = cellX(row.length, i);
        const isEdge = (i === 0 || i === row.length - 1);
        let state = isEdge ? 'edge' : 'normal';
        if (r === 7 && stepIdx >= 2) {
          if (i === highlight - 1 || i === highlight) state = 'highlight';
        }
        svg.appendChild(makeCell(x, y, row[i], state));
      }
    }

    const yNew = rows.length * ROW_H + 10;
    const yRow7 = (rows.length - 1) * ROW_H + 10;

    for (let i = 0; i < N8; i++) {
      const x = cellX(N8, i);
      const isEdge = (i === 0 || i === N8 - 1);
      let state, label;
      if (isEdge) {
        state = 'edge'; label = '1';
      } else if (stepIdx === 0) {
        state = 'blank'; label = '?';
      } else if (stepIdx === 1) {
        state = 'blank'; label = '?';
      } else {
        if (i < highlight) {
          state = 'sum'; label = String(ROW8[i]);
        } else if (i === highlight) {
          state = 'sum'; label = String(ROW8[i]);
        } else {
          state = 'blank'; label = '?';
        }
      }
      svg.appendChild(makeCell(x, yNew, label, state));
    }

    if (stepIdx >= 2 && highlight >= 1 && highlight <= N8 - 2) {
      const row7len = rows[7].length;
      const leftCX  = cellCX(row7len, highlight - 1);
      const rightCX = cellCX(row7len, highlight);
      const targetCX = cellCX(N8, highlight);
      const arrowY1 = yRow7 + CH;
      const arrowY2 = yNew;
      addArrow(svg, leftCX,  arrowY1, targetCX, arrowY2);
      addArrow(svg, rightCX, arrowY1, targetCX, arrowY2);
    }

    const viewH = yNew + CH + 20;
    svg.setAttribute('viewBox', `0 0 680 ${viewH}`);

    const row7 = rows[7];
    const interiorSteps = Array.from({length: N8 - 2}, (_, i) => {
      const li = i, ri = i + 1;
      return `${row7[li]} + ${row7[ri]} = ${ROW8[i+1]}`;
    });

    const instructions = [
      'First, add 1\'s on the outside — every row of Pascal\'s triangle starts and ends with 1.',
            'To fill in the question marks in the middle, we add the two numbers above the question mark. Click next to see!',
      ...interiorSteps
    ];

    document.getElementById('pt-instr').textContent = instructions[stepIdx];
    document.getElementById('pt-prev').disabled = stepIdx === 0;
    document.getElementById('pt-next').disabled = stepIdx === totalSteps - 1;

    const dotsEl = document.getElementById('pt-dots');
    dotsEl.innerHTML = '';
    for (let i = 0; i < totalSteps; i++) {
      const d = document.createElement('div');
      d.className = 'pt-dot' + (i === stepIdx ? ' active' : '');
      dotsEl.appendChild(d);
    }
  }

  let current = 0;
  window.ptStep = function(dir) {
    const totalSteps = 2 + (N8 - 2);
    current = Math.max(0, Math.min(totalSteps - 1, current + dir));
    render(current);
  };

  render(0);
})();
</script>

<p>
You can continue Pascal's triangle indefinitely by using this summation pattern. Pascal's triangle has great importance in mathematics (it's entries are called <em>binomial coefficients</em>, and appear in expansions of binomials, in combinatorics, and in many other parts of math). 
</p>

<p>
However, in today's article, we won't be exploring those uses of Pascal's triangle. Instead, we wanted to showcase a very pretty pattern. 
</p>

