<script>
(function() {
  const examples = [
    { n: 4, k: 2, title: 'Example 1' },
    { n: 5, k: 4, title: 'Example 2' },
    { n: 11, k: 3, title: 'Example 3' }
  ];
  let custom = { n: 6, k: 2 };
  const totalSlides = 4;
  let current = 0;

  function nCk(n, k) {
    if (k < 0 || k > n) return 0n;
    k = Math.min(k, n - k);
    let res = 1n;
    for (let i = 0; i < k; i++) {
      res = res * BigInt(n - i) / BigInt(i + 1);
    }
    return res;
  }

  function bitsOf(x, len) {
    return x.toString(2).padStart(len, '0').split('').map(Number);
  }

  function binomHTML(n, k) {
    return `<span class="bp-binom"><span class="bp-binom-paren">(</span><span class="bp-binom-stack"><span>${n}</span><span>${k}</span></span><span class="bp-binom-paren">)</span></span>`;
  }

  function renderPair(n, k) {
    const eqEl = document.getElementById('bp-eq');
    const bitsEl = document.getElementById('bp-bits');
    const conclEl = document.getElementById('bp-conclusion');

    if (!Number.isInteger(n) || !Number.isInteger(k) || n < 0 || k < 0) {
      eqEl.textContent = '';
      bitsEl.innerHTML = '';
      conclEl.innerHTML = '<span class="bp-error">Please enter non-negative whole numbers.</span>';
      return;
    }
    if (k > n) {
      eqEl.innerHTML = `${binomHTML(n, k)}<span class="bp-eq-rest">=</span><span class="bp-eq-value">0</span>`;
      bitsEl.innerHTML = '';
      conclEl.innerHTML = '<span class="bp-word bp-word-even">even</span>';
      return;
    }

    const value = nCk(n, k);
    const len = Math.max(n.toString(2).length, k.toString(2).length);
    const nBits = bitsOf(n, len);
    const kBits = bitsOf(k, len);

    eqEl.innerHTML = `${binomHTML(n, k)}<span class="bp-eq-rest">=</span><span class="bp-eq-value">${value.toString()}</span>`;

    let badCol = -1;
    for (let i = 0; i < len; i++) {
      if (kBits[i] > nBits[i]) { badCol = i; break; }
    }
    const isEven = badCol !== -1;

    let html = '<table class="bp-bits-table"><tr><td class="bp-label">n = ' + n + '</td>';
    for (let i = 0; i < len; i++) {
      const cls = i === badCol ? 'bp-bad' : (badCol === -1 ? 'bp-ok' : '');
      html += `<td class="${cls}">${nBits[i]}</td>`;
    }
    html += '</tr><tr><td class="bp-label">k = ' + k + '</td>';
    for (let i = 0; i < len; i++) {
      const cls = i === badCol ? 'bp-bad' : (badCol === -1 ? 'bp-ok' : '');
      html += `<td class="${cls}">${kBits[i]}</td>`;
    }
    html += '</tr></table>';
    bitsEl.innerHTML = html;

    conclEl.innerHTML = isEven
      ? '<span class="bp-word bp-word-even">even</span>'
      : '<span class="bp-word bp-word-odd">odd</span>';
  }

  function render(idx) {
    const titleEl = document.getElementById('bp-title');
    const inputsWrap = document.getElementById('bp-inputs-wrap');

    if (idx < 3) {
      const ex = examples[idx];
      titleEl.textContent = ex.title;
      inputsWrap.innerHTML = '';
      renderPair(ex.n, ex.k);
    } else {
      titleEl.textContent = 'Try your own';
      inputsWrap.innerHTML = `
        <div class="bp-inputs">
          <div class="bp-input-group">
            <label for="bp-n-input">n</label>
            <input type="number" id="bp-n-input" min="0" max="60" value="${custom.n}">
          </div>
          <div class="bp-input-group">
            <label for="bp-k-input">k</label>
            <input type="number" id="bp-k-input" min="0" max="60" value="${custom.k}">
          </div>
        </div>`;
      const nInput = document.getElementById('bp-n-input');
      const kInput = document.getElementById('bp-k-input');
      const update = () => {
        const n = parseInt(nInput.value, 10);
        const k = parseInt(kInput.value, 10);
        custom = { n: isNaN(n) ? 0 : n, k: isNaN(k) ? 0 : k };
        if (!isNaN(n) && n > 60) { nInput.value = 60; custom.n = 60; }
        if (!isNaN(k) && k > 60) { kInput.value = 60; custom.k = 60; }
        renderPair(custom.n, custom.k);
      };
      nInput.addEventListener('input', update);
      kInput.addEventListener('input', update);
      renderPair(custom.n, custom.k);
    }

    document.getElementById('bp-prev').disabled = idx === 0;
    document.getElementById('bp-next').disabled = idx === totalSlides - 1;

    const dotsEl = document.getElementById('bp-dots');
    dotsEl.innerHTML = '';
    for (let i = 0; i < totalSlides; i++) {
      const d = document.createElement('div');
      d.className = 'bp-dot' + (i === idx ? ' active' : '');
      dotsEl.appendChild(d);
    }
  }

  window.bpStep = function(dir) {
    current = Math.max(0, Math.min(totalSlides - 1, current + dir));
    render(current);
  };

  render(0);
})();
</script>

<p>
We can make the pattern even easier to trace by labelling each cell with the actual bits involved, instead of the value of \(\binom{n}{k}\). Below, every cell shows the binary expansion of \(n\) stacked directly above the binary expansion of \(k\) (padded to the same length). Compare the two rows of digits column by column: whenever a 1 in \(k\)'s row sits above a 0 in \(n\)'s row, the entry is even — otherwise it's odd. That's Lucas' theorem, cell by cell.
</p>

